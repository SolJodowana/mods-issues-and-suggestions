name: Bug report
description: Something isn't working as expected
labels: [bug]
body:
  - type: dropdown
    id: mod
    attributes:
      label: Which mod is this about?
      options:
        - Artificier's Almanac
        - Bookbinder's Almanac
        - Colossi
        - Elemental Motes
        - Quintessence
        - Spell's Atlas
        - Tempest Almanac
        - Other
    validations: { required: true }
  - type: input
    id: mod_version
    attributes:
      label: Mod version
    validations: { required: true }
  - type: input
    id: mc_version
    attributes:
      label: Minecraft version and loader
    validations: { required: true }
  - type: input
    id: ispells_version
    attributes:
      label: Iron's Spells 'n Spellbooks version
  - type: textarea
    id: description
    attributes:
      label: Description and steps to reproduce
    validations: { required: true }
  - type: textarea
    id: log
    attributes:
      label: Log / crash report
      description: Paste a link (e.g. mclo.gs) instead of the full log
